# Copie para .env e preencha antes de rodar localmente.

# Postgres do Railway em produção; sqlite local por padrão para testar.
DATABASE_URL=sqlite:///./dev.db

# Credenciais OAuth do Google (criar em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lista de e-mails autorizados a acessar o dashboard, separados por vírgula.
ALLOWED_EMAILS=diretoria@altamidia.com

# Chave para assinar o cookie de sessão — gere uma string aleatória longa em produção.
SESSION_SECRET=troque-esta-chave-em-producao
